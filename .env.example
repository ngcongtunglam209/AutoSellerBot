# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Sepay API
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_BANK_CODE=your_bank_code
SEPAY_ACCOUNT_NAME=YOUR ACCOUNT NAME

# Server
PORT=3000
WEBHOOK_URL=https://yourdomain.com/webhook/sepay

# Admin Password
ADMIN_PASSWORD=your_admin_password_here

# Order expiry in minutes
ORDER_EXPIRY_MINUTES=15

# Chiết khấu mua số lượng (tiếp bậc): DISCOUNT_TIERS là mảng JSON các mức [{"minQty": N, "percent": X}]
# - quantity > minQty thì áp dụng giảm X% trên tổng giá gốc
# - Hệ thống tự chọn mức cao nhất phù hợp
# Ví dụ: mua >5 giảm 5%, >10 giảm 10%, >20 giảm 15%
DISCOUNT_TIERS=[{"minQty":5,"percent":5},{"minQty":10,"percent":10},{"minQty":20,"percent":15}]
# Để trống để tắt chiết khấu: DISCOUNT_TIERS=
