# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Sepay API
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_BANK_CODE=your_bank_code
SEPAY_ACCOUNT_NAME=YOUR ACCOUNT NAME

# Server
PORT=3000
WEBHOOK_URL=https://yourdomain.com/webhook/sepay

# Admin Password
ADMIN_PASSWORD=your_admin_password_here

# Order expiry in minutes
ORDER_EXPIRY_MINUTES=15

# Bulk discount: mua > DISCOUNT_MIN_QTY sp thi giam DISCOUNT_PER_ITEM moi sp
# Vi du: mua >5 sp, moi sp giam 5000d => DISCOUNT_MIN_QTY=5, DISCOUNT_PER_ITEM=5000
# De 0 de tat chiet khau
DISCOUNT_MIN_QTY=5
DISCOUNT_PER_ITEM=0
